# Additional contextual and regional layout.
@NambliAboveMarks = [uni0300 uni0301 uni0302 uni0303 uni0304 uni0305 uni0306 uni0307 uni0308 uni0309 uni030A uni030B uni030C uni030D uni030F uni0311 uni0313 uni1DC4 uni1DC5 uni1DC6 uni1DC7];
lookup NambliSoftDottedExtended {
  lookupflag UseMarkFilteringSet @NambliAboveMarks;
  sub i' @NambliAboveMarks by idotless.alt;
  sub i.loclTRK' @NambliAboveMarks by idotless.alt;
  sub j' @NambliAboveMarks by uni0237;
  sub uni012F' @NambliAboveMarks by uni012F.dotless;
  sub uni0249' @NambliAboveMarks by uni0249.dotless;
  sub uni0268' @NambliAboveMarks by uni0268.dotless;
  sub uni029D' @NambliAboveMarks by uni029D.dotless;
  sub uni0456' @NambliAboveMarks by uni0456.dotless;
  sub uni0458' @NambliAboveMarks by uni0458.dotless;
  sub uni1DA4' @NambliAboveMarks by uni1DA4.dotless;
  sub uni1E2D' @NambliAboveMarks by uni1E2D.dotless;
  sub uni1ECB' @NambliAboveMarks by uni1ECB.dotless;
  sub uni2071' @NambliAboveMarks by uni2071.dotless;
} NambliSoftDottedExtended;
feature ccmp { lookup NambliSoftDottedExtended; } ccmp;

feature locl {
  script latn;
  language CAT;
  sub l uni00B7' l by periodcentered.loclCAT;
  sub L uni00B7' L by periodcentered.loclCAT.case;
  language TRK;
  sub i by i.loclTRK;
  language AZE;
  sub i by i.loclTRK;
  language CRT;
  sub i by i.loclTRK;
  language CSY;
  sub [d l t L] uni030C' by uni030C.alt;
  language SKY;
  sub [d l t L] uni030C' by uni030C.alt;
} locl;
